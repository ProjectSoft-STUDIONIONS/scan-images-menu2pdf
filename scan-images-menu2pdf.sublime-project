{
	"folders":
	[
		{
			"path": ".",
			"name": "Конвертирование отсканированных изображений меню в PDF файлы",
			"file_include_patterns": [
				"*.exe",
				"*.*"
			],
			"file_exclude_patterns": [
				"*.dcu",
				"*.spec",
				"*.dproj.local",
				"*.identcache",
				"*_.json",
				"*.sublime-workspace",
				"*.txt"
			],
			"folder_exclude_patterns": [
				"__history",
				"__recovery"
			]
		}
	],
    "settings":
	{
		"tab_size": 4,
		"font_size": 14,
		"font_face": "JetBrains Mono"
	},
	"build_systems":
	[
		{
			"name": "Запуск проекта",
			"working_dir": "${project_path}",
			"cmd": ["start", "node", "${project_path}/index.js"],
			"shell": true
		},
		{
			"name": "Запуск app",
			"working_dir": "${project_path}",
			"cmd": [
				"start",
				"/wait",
				"/d",
				"bin",
				"programm.exe"
			],
			"shell": true
		}
	]
}
